{
  "build": {
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "partitions_app_new.csv",
      "memory_type": "qio_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=0",
      "-DARDUINO_USB_CDC_ON_BOOT=0",
      "-DBOARD_HAS_PSRAM"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s3",
    "variant": "esp32s3"
  },

  "connectivity": [
    "wifi",
    "bluetooth"
  ],

  "debug": {
    "openocd_target": "esp32s3.cfg"
  },

  "frameworks": [
    "arduino"
  ],

  "name": "Kode Dot",

  "upload": {
    "flash_size": "32MB",
    "maximum_ram_size": 524288,
    "maximum_size": 33554432,
    "require_upload_port": true,
    "speed": 921600
  },

  "vendor": "kode.",
  "url": "https://kode.diy"
}